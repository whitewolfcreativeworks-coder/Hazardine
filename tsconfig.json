{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "sim",
    "web",
    "tests",
    "tools"
  ]
}